generator client {
  provider      = "prisma-client"
  output        = "./generated"
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  invitesCreated Invite[]

  events Event[]

  signupMailsSent SignupMail[]

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId String
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Account {
  id String @id @default(cuid())

  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  email      String
  roleName   String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String

  @@index([email])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Event {
  id                  String   @id @default(cuid())
  title               String
  description         String
  menuDescription     String?
  donationDescription String?
  date                DateTime
  slots               Int
  // a draft (false) is only visible in the admin area: the public pages,
  // the signup form and the gallery all leave it out
  published           Boolean  @default(true)
  price               Int
  // CHF taken off `price` for a guest who ticks the signup form's "student"
  // or "vegetarian" checkbox; the two stack. null means no such discount.
  studentDiscount     Int?
  vegetarianDiscount  Int?
  discounts           String?
  // the signup mail's subject and message, one pair per outcome; null falls
  // back to the default copy in app/features/signup-form/confirmation-mail.ts
  confirmedMailSubject String?
  confirmedMailMessage String?
  waitlistMailSubject  String?
  waitlistMailMessage  String?
  // what TWINT keeps of each payment made through it, for the money received
  // on the signup sheet: this share of the amount plus a fixed sum. Cash
  // payments cost nothing.
  twintFeePercent      Float   @default(1.5)
  twintFeeFixedRappen  Int     @default(30)

  // the cover slot — deleting the image leaves the event standing (SetNull)
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageId String? @unique

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  eventResponses EventResponse[]

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String?

  form   Form   @relation(fields: [formId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formId String @unique

  galleryImages EventGalleryImage[]

  volunteers Volunteer[]

  checklistItems EventChecklistItem[]
}

// The organisers' to-do list for one dinner (book a photographer, buy wine,
// …). Admin-only bookkeeping, never shown on the public site.
model EventChecklistItem {
  id       String    @id @default(cuid())
  label    String
  position Int       @default(0)
  doneAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String

  @@index([eventId])
}

model Form {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FormVersion[]
  event    Event?
}

model FormVersion {
  id      String @id @default(cuid())
  version Int
  schema  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  formId String

  submissions FormSubmission[]

  @@unique([formId, version])
}

model FormSubmission {
  id      String @id @default(cuid())
  answers Json
  // "confirmed" | "waitlisted" | "cancelled", decided when the signup is
  // stored (app/models/event-signup.server.ts); only confirmed seats count
  // against Event.slots
  status  String @default("confirmed")
  // the signer plus their friends, fixed at signup
  seats   Int    @default(1)
  // lowercased, to stop one address from signing up twice for an event
  email   String @default("")
  // admin bookkeeping for the staggered payments: whether each half of what
  // the party owes has come in. Never shown to the guest.
  firstHalfPaid  Boolean @default(false)
  secondHalfPaid Boolean @default(false)
  // how each half came in: "twint" or "cash"
  // (app/features/signup-form/payments.ts). TWINT keeps a fee of each.
  firstHalfMethod  String @default("twint")
  secondHalfMethod String @default("twint")
  // an admin's own mark of whether the mail the status calls for (the seat
  // confirmation, or the waiting-list mail) went out, for mails sent by hand
  // or lost on the way. null goes by the SignupMail records. Cleared when the
  // status changes and when the site sends that mail itself.
  confirmationMarkedSent Boolean?
  // ticked by an admin once the party has been reminded to pay
  paymentReminderSent    Boolean  @default(false)
  // free text for the admin team, e.g. "pays by transfer, allergy call"
  adminNote String @default("")
  // false for signups stored before the site kept a record of the mails it
  // sends (SignupMail), and for signups copied in from the live site: for
  // those, no record doesn't mean no mail
  mailsTracked Boolean @default(true)

  createdAt DateTime @default(now())

  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formVersionId String

  mails SignupMail[]

  guestBookkeeping SignupGuest[]
}

// The admin's bookkeeping for one person in a signup, kept on the signup
// sheet during the dinner. Who the person is stays in FormSubmission.answers;
// a person nobody has ticked or noted anything for has no row.
model SignupGuest {
  id             String    @id @default(cuid())
  // their place in the booking: 0 is the signer, then the friends in the
  // order the signer gave them. Fixed at signup, like FormSubmission.seats.
  guestIndex     Int
  arrivedAt      DateTime?
  // what they gave on the night, in Rappen; null when nothing is entered
  donationRappen Int?
  // "twint" or "cash", like the payment halves
  donationMethod String    @default("twint")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submissionId String

  @@unique([submissionId, guestIndex])
}

// One mail that went out about a signup, so the signup sheet can show who
// has heard from us and what we told them. A mail that failed to send leaves
// no row.
model SignupMail {
  id        String   @id @default(cuid())
  // "confirmed" or "waitlisted": the signup mail to the signer, with that
  // outcome (app/features/signup-form/confirmation-mail.server.ts);
  // "friend": the note to a friend the signer gave an address for;
  // "custom": a message an admin wrote on the signup sheet
  kind      String
  recipient String
  // what an admin wrote, placeholders filled in; empty for the site's own
  // mails, whose wording lives in the site texts
  subject   String   @default("")
  message   String   @default("")
  createdAt DateTime @default(now())

  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submissionId String

  // the admin who sent it from the signup sheet; null when it went out on
  // its own, at signup
  sentBy   User?   @relation(fields: [sentById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sentById String?

  @@index([submissionId])
}

model EventResponse {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String   @default("")
  vegetarian   Boolean?
  student      Boolean?
  restrictions String?
  comment      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String
}

model Address {
  id          String  @id @default(cuid())
  streetName  String
  houseNumber String
  zip         String
  city        String
  events      Event[]

  @@unique([streetName, houseNumber, zip, city])
}

// A pure stored asset: provider metadata only, no owner FKs. Whatever shows
// an image points here — the cover/portrait slots via their own imageId, the
// galleries via EventGalleryImage links.
model Image {
  id          String  @id @default(cuid())
  altText     String?
  contentType String
  // provider key (Cloudinary public_id / local file key) — the row's only
  // link to its bytes since `blob` was dropped, so it is required
  storageKey  String
  version     Int?
  width       Int?
  height      Int?
  blurDataUrl String?
  // the admin's framing (app/shared/image-crop.ts): the part of the photo to
  // show, as fractions of its width and height. All four or none; none shows
  // the photo whole. The file itself is never cut.
  cropX       Float?
  cropY       Float?
  cropWidth   Float?
  cropHeight  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event?
  boardMember  BoardMember?
  volunteer    Volunteer?
  galleryLinks EventGalleryImage[]
}

// Grants one image membership in one event's gallery. Deleting a link
// unlinks without destroying the asset, and the same photo can be shown
// under two events with different captions.
model EventGalleryImage {
  id       String  @id @default(cuid())
  caption  String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageId String

  // one membership per (event, image) pair — re-adding is idempotent
  @@unique([eventId, imageId])
  @@index([eventId])
  @@index([imageId])
}

model BoardMember {
  id       String @id @default(cuid())
  name     String
  position String
  bio      String?

  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The people who cook, host and wash up. Separate from the board: a volunteer
// has no office, and can be credited on the evenings they helped with.
model Volunteer {
  id   String  @id @default(cuid())
  name String
  // a short tagline — "kitchen", "host", "dishes" — optional
  role String?
  bio  String?

  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageId String? @unique

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An admin's edit of one public-facing text (app/features/site-text). A text
// nobody has edited has no row and shows the default written in the code.
model SiteText {
  // the registry key, e.g. "landing.vision.headline"
  key           String @id
  value         String
  // the code's default when this was saved, so the editor can point out an
  // edit whose default has changed since
  defaultAtEdit String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One anonymous hit for the admin statistics (app/features/stats). Neither a
// cookie nor an address is kept: `visitor` is a hash salted with a key that
// lives in memory for one day and is never stored, so it tells hits apart
// within that day and nothing more. Staff browsers and bots never get here.
model StatHit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // the Zürich calendar day of the hit, "2026-11-05": what the charts group by
  day       String
  // "pageview", "signup_start", "signup_submit", "signup" or "outbound"
  kind      String
  // the page, with private segments (invite tokens) taken out
  path      String
  // the dinner the page belongs to; not a relation, so the numbers outlive
  // a deleted event
  eventId   String?
  visitor   String
  // how the visit arrived: "qr", "instagram", "google", … a referring site's
  // host, "internal" (from another page here) or "direct"
  source    String
  // the previous page for internal visits, the referring host otherwise
  referrer  String?
  // "mobile", "tablet" or "desktop" by the window width; "unknown" when
  // the server records the hit (a stored signup)
  device    String
  // per kind: the signup outcome, the outbound link's host
  detail    String?

  @@index([day, kind])
  @@index([eventId, kind])
}
